---
import Layout from "../../layouts/Layout.astro";
import projects from "../../content/projects.json";

type Project = (typeof projects)[number];

export function getStaticPaths() {
  const all = projects as Project[];
  return all.map((project, i) => ({
    params: { slug: project.slug },
    props: {
      project,
      prev: all[(i - 1 + all.length) % all.length],
      next: all[(i + 1) % all.length],
    },
  }));
}

const { project, prev, next } = Astro.props as { project: Project; prev: Project; next: Project };
---

<Layout title={`${project.title} — Greta Ferreira`}>
  <main class="project">
    <h1 class="heading-serif project__title">{project.title}</h1>
    <p class="project__desc">{project.description}</p>

    <div class="project__media">
      {
        project.media.map((item) =>
          item.video ? (
            <video src={item.video} poster={item.image ?? undefined} controls playsinline />
          ) : item.image ? (
            <img src={item.image} alt={item.alt ?? project.title} loading="lazy" />
          ) : null
        )
      }
    </div>

    {
      project.credits && (
        <details class="credits">
          <summary class="nav-label">Credits</summary>
          <div class="credits__body" set:html={project.credits} />
        </details>
      )
    }

    <nav class="project-nav">
      <a class="project-nav__link project-nav__link--prev" href={`/projects/${prev.slug}`}>
        <span class="nav-label">&larr; Previous</span>
        <span class="project-nav__title">{prev.title}</span>
      </a>
      <a class="nav-label back-home" href="/">Back home</a>
      <a class="project-nav__link project-nav__link--next" href={`/projects/${next.slug}`}>
        <span class="nav-label">Next &rarr;</span>
        <span class="project-nav__title">{next.title}</span>
      </a>
    </nav>
  </main>
</Layout>

<style>
  .project {
    padding: 0 var(--edge) 160px;
    max-width: 900px;
    margin: 0 auto;
  }
  .project__title {
    font-size: clamp(2rem, 6vw, 3rem);
    text-align: center;
    text-wrap: balance;
  }
  .project__desc {
    text-align: center;
    color: var(--fg-muted);
    font-size: 1.4rem;
    max-width: 560px;
    margin: 16px auto 48px;
    text-wrap: balance;
  }
  .project__media {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .project__media img,
  .project__media video {
    width: 100%;
    display: block;
  }
  .credits {
    margin-top: 64px;
  }
  .credits__body {
    margin-top: 16px;
    color: var(--fg-muted);
    font-size: 0.95rem;
    /* Greta: less spacing between credit lines. */
    line-height: 1.35;
  }
  .credits__body :global(p) {
    margin: 0 0 4px;
  }
  .credits__body :global(a) {
    text-decoration: underline;
  }

  /* Greta: next on the right, previous on the left, not everything centered —
     single-line + ellipsis so long project names never wrap to two lines
     (that's what forced the old Framer version into a centered/stacked layout). */
  .project-nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    margin-top: 64px;
  }
  .project-nav__link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
    flex: 1;
  }
  .project-nav__link--next {
    align-items: flex-end;
    text-align: right;
  }
  .project-nav__title {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: 1.1rem;
    color: var(--fg);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    max-width: 100%;
  }
  .back-home {
    flex-shrink: 0;
  }
</style>
