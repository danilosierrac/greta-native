---
import Layout from "../../layouts/Layout.astro";
import projects from "../../content/projects.json";
import { pageReveal } from "../../scripts/page-transition";

type Project = (typeof projects)[number];

export function getStaticPaths() {
  const all = projects as Project[];
  return all.map((project, i) => ({
    params: { slug: project.slug },
    props: {
      project,
      prev: all[(i - 1 + all.length) % all.length],
      next: all[(i + 1) % all.length],
    },
  }));
}

const { project, prev, next } = Astro.props as { project: Project; prev: Project; next: Project };

// The cover already "arrived" as the hero via the carousel's shared-element
// morph (see Carousel.astro) — shown once, up top, full-bleed. The gallery
// below is everything else, so the cover doesn't repeat immediately under
// itself.
const restOfMedia = project.media.filter((item) => item.image !== project.cover);
---

<Layout title={`${project.title} — Greta Ferreira`} isProject>
  <main class="project" transition:animate={pageReveal}>
    {
      project.cover && (
        <div class="project__hero">
          <img src={project.cover} alt={project.title} transition:name="project-cover" />
        </div>
      )
    }

    <div class="project__content">
      <h1 class="heading-serif project__title" data-reveal>{project.title}</h1>
      <p class="project__desc" data-reveal>{project.description}</p>

      <div class="project__media">
        {
          restOfMedia.map((item) => (
            <div class="project__media-item" data-parallax-wrap>
              {item.video ? (
                <video src={item.video} poster={item.image ?? undefined} controls playsinline data-parallax />
              ) : item.image ? (
                <img src={item.image} alt={item.alt ?? project.title} loading="lazy" data-parallax />
              ) : null}
            </div>
          ))
        }
      </div>

      {
        project.credits && (
          <details class="credits" data-credits>
            <summary class="nav-label" data-credits-summary>
              <span class="credits__arrow" data-credits-arrow>&#9656;</span> Credits
            </summary>
            <div class="credits__wrap" data-credits-wrap>
              <div class="credits__body" set:html={project.credits} />
            </div>
          </details>
        )
      }

      <nav class="project-nav">
        <a class="project-nav__link project-nav__link--prev" href={`/projects/${prev.slug}`}>
          <span class="nav-label">&larr; Previous</span>
          <span class="project-nav__title">{prev.title}</span>
        </a>
        <a class="project-nav__link project-nav__link--next" href={`/projects/${next.slug}`}>
          <span class="nav-label">Next &rarr;</span>
          <span class="project-nav__title">{next.title}</span>
        </a>
      </nav>
    </div>
  </main>
</Layout>

<script>
  import { gsap } from "gsap";

  function initCredits() {
    document.querySelectorAll<HTMLDetailsElement>("[data-credits]").forEach((details) => {
      if (details.dataset.creditsBound) return;
      details.dataset.creditsBound = "true";

      const summary = details.querySelector<HTMLElement>("[data-credits-summary]");
      const wrap = details.querySelector<HTMLElement>("[data-credits-wrap]");
      const arrow = details.querySelector<HTMLElement>("[data-credits-arrow]");
      if (!summary || !wrap) return;

      gsap.set(wrap, { height: 0, overflow: "hidden" });

      summary.addEventListener("click", (event) => {
        event.preventDefault();
        const isOpen = details.hasAttribute("open");

        if (!isOpen) {
          details.setAttribute("open", "");
          gsap.fromTo(wrap, { height: 0 }, { height: "auto", duration: 0.5, ease: "power2.out" });
          gsap.to(arrow, { rotate: 90, duration: 0.3, ease: "power2.out" });
        } else {
          gsap.to(wrap, {
            height: 0,
            duration: 0.4,
            ease: "power2.in",
            onComplete: () => details.removeAttribute("open"),
          });
          gsap.to(arrow, { rotate: 0, duration: 0.3, ease: "power2.in" });
        }
      });
    });
  }

  initCredits();
  document.addEventListener("astro:page-load", initCredits);

  // Subtle scroll-parallax: each image drifts slightly slower than the
  // page scrolls, wrapped in an overflow-hidden container scaled up just
  // enough (CSS) that the drift never exposes an edge. The scroll listener
  // is global (window persists across navigations) and only ever attached
  // once; it re-queries [data-parallax] on every tick instead of holding a
  // reference, so a fresh project page's images are picked up automatically.
  function updateParallax() {
    document.querySelectorAll<HTMLElement>("[data-parallax]").forEach((el) => {
      const rect = el.getBoundingClientRect();
      const center = rect.top + rect.height / 2 - window.innerHeight / 2;
      // scale(1.14) matches the CSS headroom below — an inline transform
      // replaces the whole property, so it has to be repeated here or the
      // translate would overwrite the scale and expose the image's edge.
      el.style.transform = `translateY(${center * -0.08}px) scale(1.14)`;
    });
  }

  if (!(window as any).__parallaxBound) {
    (window as any).__parallaxBound = true;
    let ticking = false;
    window.addEventListener(
      "scroll",
      () => {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          updateParallax();
          ticking = false;
        });
      },
      { passive: true }
    );
  }

  if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) updateParallax();
  document.addEventListener("astro:page-load", updateParallax);
</script>

<style>
  .project {
    padding-bottom: 160px;
  }
  /* A contained card, not a banner — this is the same tile that was
     tapped, just grown and brought forward (see Carousel.astro's
     goToProject), so it keeps reading as "that card, closer" rather than
     turning into a different kind of object once you arrive. */
  .project__hero {
    max-width: 640px;
    max-height: 72vh;
    margin: 40px auto 0;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 40px 80px -20px rgba(0, 0, 0, 0.6);
  }
  .project__hero img {
    width: 100%;
    height: 100%;
    max-height: 72vh;
    object-fit: cover;
    display: block;
  }
  .project__content {
    padding: 0 var(--edge);
    max-width: 900px;
    margin: 0 auto;
  }
  .project__title {
    font-size: clamp(2rem, 6vw, 3rem);
    text-align: center;
    text-wrap: balance;
    /* The title "arrives" just after the card settles, not glued to it. */
    margin-top: clamp(32px, 8vw, 56px);
  }
  .project__desc {
    text-align: center;
    color: var(--fg-muted);
    font-size: 1.4rem;
    max-width: 560px;
    margin: 16px auto 48px;
    text-wrap: balance;
  }
  .project__media {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
  .project__media-item {
    overflow: hidden;
  }
  .project__media img,
  .project__media video {
    width: 100%;
    display: block;
    /* Headroom for the parallax translateY so it never exposes an edge. */
    transform: scale(1.14);
    will-change: transform;
  }
  .credits {
    margin-top: 64px;
  }
  .credits__arrow {
    display: inline-block;
    transform-origin: 45% 50%;
  }
  .credits summary {
    cursor: pointer;
    list-style: none;
  }
  .credits summary::-webkit-details-marker {
    display: none;
  }
  .credits__body {
    padding-top: 16px;
    color: var(--fg-muted);
    font-size: 0.95rem;
    /* Greta: less spacing between credit lines. */
    line-height: 1.35;
  }
  .credits__body :global(p) {
    margin: 0 0 4px;
  }
  .credits__body :global(a) {
    text-decoration: underline;
  }

  /* Greta: next on the right, previous on the left, not everything centered.
     Long titles wrap to two lines (that's fine — it's what forced the old
     Framer layout centered/stacked) instead of being truncated illegibly. */
  .project-nav {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    margin-top: 64px;
  }
  .project-nav__link {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
    flex: 1;
  }
  .project-nav__link--next {
    align-items: flex-end;
    text-align: right;
  }
  .project-nav__title {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: 1.1rem;
    color: var(--fg);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
