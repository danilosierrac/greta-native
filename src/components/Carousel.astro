---
// The signature moment of the homepage — ported from the Framer liquid-glass
// carousel. See src/scripts/carousel-engine.ts for the WebGL/GSAP engine
// itself; this component just mounts it, feeds it real project data, and
// wires taps to real navigation (no more CMS-link workarounds needed).
import projects from "../content/projects.json";

type Project = (typeof projects)[number];
const items = (projects as Project[])
  .map((p) => ({ src: p.cover ?? p.media.find((m) => m.image)?.image, title: p.title, slug: p.slug }))
  .filter((p): p is { src: string; title: string; slug: string } => Boolean(p.src));
---

<div class="carousel" data-carousel>
  <div class="carousel__host" data-host></div>
  <div class="carousel__caption" data-label></div>
  <div class="carousel__counter" data-counter></div>
</div>

<script define:vars={{ items }}>
  window.__carouselItems = items;
</script>

<script>
  import { gsap } from "gsap";
  import { createCarousel, DEFAULT_SETTINGS } from "../scripts/carousel-engine";
  import { navigate } from "astro:transitions/client";

  // Shared view-transition name for whichever tile was actually tapped —
  // matched by the hero <img> on the project page (see [slug].astro). Only
  // one navigation is ever in flight, so a single fixed name is enough;
  // it doesn't need to be per-slug.
  const COVER_TRANSITION_NAME = "project-cover";

  // The anchors are children of `host`, so a touch tap's pointerup bubbles
  // up into the engine's own pointerup handler (onTap) as well as firing
  // the anchor's native click — without this guard a single tap called
  // goToProject twice on touch devices, double-navigating mid-transition.
  let navigating = false;

  function goToProject(rect: DOMRect | { left: number; top: number; width: number; height: number }, src: string, slug: string) {
    if (navigating) return;
    navigating = true;
    // The tile "comes forward" — a ghost <img> takes over from the WebGL
    // canvas at the tapped tile's exact rect, lifts slightly, then the
    // real navigation starts. Because it carries the same
    // view-transition-name as the project page's hero image, the browser
    // morphs seamlessly from this ghost into that image — the canvas
    // itself just fades away as part of the normal page transition.
    const ghost = document.createElement("img");
    ghost.src = src;
    ghost.style.cssText = `position:fixed;left:${rect.left}px;top:${rect.top}px;width:${rect.width}px;height:${rect.height}px;object-fit:cover;z-index:50;pointer-events:none;`;
    (ghost.style as any).viewTransitionName = COVER_TRANSITION_NAME;
    document.body.appendChild(ghost);

    gsap.to(ghost, {
      scale: 1.06,
      boxShadow: "0 30px 60px -10px rgba(0,0,0,0.5)",
      duration: 0.22,
      ease: "power2.out",
      onComplete: () => {
        // navigate() only rejects if the swap itself fails (not on the
        // cosmetic view-transition abort noise) — reset so a failed
        // attempt doesn't leave every further tap silently ignored.
        navigate(`/projects/${slug}`)?.catch?.(() => {
          navigating = false;
        });
      },
    });
  }

  function mount() {
    const root = document.querySelector<HTMLDivElement>("[data-carousel]");
    const host = root?.querySelector<HTMLDivElement>("[data-host]");
    const labelEl = root?.querySelector<HTMLDivElement>("[data-label]");
    const counterEl = root?.querySelector<HTMLDivElement>("[data-counter]");
    const items = (window as any).__carouselItems as { src: string; title: string; slug: string }[];
    if (!root || !host || !items?.length) return;

    // One real <a> per project, absolutely positioned over its panel every
    // frame — a genuine link (crawlable, keyboard-reachable) layered on top
    // of the canvas, which only ever draws pixels.
    const anchors = items.map((item) => {
      const a = document.createElement("a");
      a.href = `/projects/${item.slug}`;
      a.setAttribute("aria-label", item.title);
      a.style.cssText =
        "position:absolute;top:0;left:0;display:none;z-index:2;text-decoration:none;color:transparent;font-size:0;" +
        "touch-action:pan-y;user-select:none;-webkit-user-select:none;-webkit-touch-callout:none;-webkit-tap-highlight-color:transparent;";
      a.textContent = item.title;
      a.addEventListener("click", (event) => {
        if (engine?.consumedByDrag()) {
          event.preventDefault();
          return;
        }
        event.preventDefault();
        goToProject(a.getBoundingClientRect(), item.src, item.slug);
      });
      host.appendChild(a);
      return a;
    });

    let active = 0;
    let entryDone = !DEFAULT_SETTINGS.entry;

    function updateCaption() {
      if (labelEl) {
        labelEl.textContent = items[active]?.title ?? "";
        labelEl.style.opacity = entryDone ? "1" : "0";
      }
      if (counterEl) {
        counterEl.textContent = `${String(active + 1).padStart(2, "0")}/${String(items.length).padStart(2, "0")}`;
        counterEl.style.opacity = entryDone ? "1" : "0";
      }
    }

    const engine = createCarousel(host, {
      projects: items,
      settings: DEFAULT_SETTINGS,
      onActiveChange: (index) => {
        active = index;
        updateCaption();
      },
      onEntryDone: (done) => {
        entryDone = done;
        updateCaption();
      },
      onRects: (rects) => {
        rects.forEach((rect, index) => {
          const a = anchors[index];
          if (!a) return;
          if (!rect) {
            a.style.display = "none";
            return;
          }
          a.style.display = "block";
          a.style.transform = `translate3d(${rect.left}px, ${rect.top}px, 0)`;
          a.style.width = `${rect.width}px`;
          a.style.height = `${rect.height}px`;
        });

        // The caption follows the panel nearest the centre, so it never
        // drifts down into whatever section follows the carousel.
        const hostWidth = host.clientWidth;
        const middle = hostWidth / 2;
        let centred: { left: number; top: number; width: number; height: number } | null = null;
        let best = Infinity;
        rects.forEach((rect) => {
          if (!rect) return;
          const distance = Math.abs(rect.left + rect.width / 2 - middle);
          if (distance < best) {
            best = distance;
            centred = rect;
          }
        });
        if (centred) {
          const tile = centred as { left: number; top: number; width: number; height: number };
          if (labelEl) labelEl.style.transform = `translate3d(0, ${tile.top + tile.height + 20}px, 0)`;
          if (counterEl) counterEl.style.transform = `translate3d(0, ${tile.top - 40}px, 0)`;
        }
      },
      onTap: (sourceIndex) => {
        if (engine?.consumedByDrag()) return;
        const item = items[sourceIndex];
        const anchor = anchors[sourceIndex];
        // The anchor is repositioned to match its panel every frame, so its
        // current rect is the tapped tile's rect.
        goToProject(anchor ? anchor.getBoundingClientRect() : { left: 0, top: 0, width: 0, height: 0 }, item.src, item.slug);
      },
    });

    updateCaption();

    // Astro swaps the DOM on navigation; the engine's own resources (canvas,
    // GL context, listeners) need tearing down explicitly or they leak.
    document.addEventListener(
      "astro:before-swap",
      () => {
        engine.destroy();
      },
      { once: true }
    );
  }

  // astro:page-load fires on the very first load too, not just after a
  // transition — calling mount() directly as well double-mounted the engine.
  document.addEventListener("astro:page-load", mount);
</script>

<style>
  .carousel {
    position: relative;
    width: 100%;
    height: clamp(360px, 56vw, 640px);
    overflow: hidden;
  }
  .carousel__host {
    position: absolute;
    inset: 0;
    touch-action: pan-y;
    -webkit-tap-highlight-color: transparent;
  }
  .carousel__caption,
  .carousel__counter {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    display: flex;
    justify-content: center;
    pointer-events: none;
    z-index: 3;
    will-change: transform;
    transition: opacity 0.4s;
    font-family: var(--font-serif);
    font-weight: 300;
    color: var(--fg);
    text-align: center;
    padding: 0 16px;
  }
  .carousel__caption {
    font-size: 1.4rem;
    max-width: min(92vw, 520px);
    margin: 0 auto;
  }
  .carousel__counter {
    font-family: var(--font-sans);
    font-size: 0.85rem;
    color: var(--fg-muted);
  }
</style>
