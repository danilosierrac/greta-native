---
import "../styles/global.css";
import Wordmark from "../components/Wordmark.astro";
import OrbitButton from "../components/OrbitButton.astro";
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  isProject?: boolean;
}
const { title, isProject = false } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <ClientRouter />
    <script is:inline>
      // Set theme before paint to avoid a flash of the wrong scheme.
      const stored = localStorage.getItem("theme");
      if (stored === "light" || stored === "dark") {
        document.documentElement.setAttribute("data-theme", stored);
      }

      // Mirrors src/scripts/intro.ts's shouldPlayIntro() (and its isHomePath
      // check from src/scripts/paths.ts) — duplicated here rather than
      // imported because this has to run synchronously before first paint.
      // #intro-overlay defaults to display:none in CSS; this is the only
      // thing that ever makes it visible, so every page that isn't a
      // genuine first-ever load of the home route paints with zero flash.
      try {
        const isHome = !/\/projects\//.test(location.pathname);
        const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (isHome && !reduced && !sessionStorage.getItem("greta-intro-played")) {
          document.documentElement.setAttribute("data-intro", "pending");
        }
      } catch (e) {}
    </script>
  </head>
  <body>
    <!-- Plays once per session, only when "/" was the very first page this
         browser tab loaded (see src/scripts/intro.ts) — the same metallic
         wordmark that anchors the header first appears here, large and
         alone, like Jem's glass emblem materialising before anything else
         on the page is allowed to reveal itself. -->
    <div id="intro-overlay" class="intro-overlay" aria-hidden="true" transition:persist>
      <div class="intro-overlay__mark">
        <Wordmark class="intro-mark-svg" metallic="full" />
      </div>
    </div>

    <!-- Not persisted: the close button's presence genuinely differs
         between home and a project, and transition:persist would freeze
         this whole block at whatever it looked like on first mount instead
         of picking up that per-page difference. The tagline's own reveal
         already replays on every navigation regardless (see initPage
         below), so nothing here relied on persisting for its animation. -->
    <header class="site-header">
      <div class="site-header__meta">
        <span class="nav-label" data-reveal>Senior Project Management &amp; Account Manager</span>
        <div class="header-actions">
          <button class="nav-label" id="info-toggle" type="button" aria-expanded="false">Info</button>
          {
            isProject && (
              <button class="icon-button" data-home-link type="button" aria-label="Close">
                <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true">
                  <path d="M5 5 L19 19 M19 5 L5 19" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                </svg>
              </button>
            )
          }
        </div>
      </div>
      <a href="/" aria-label="Greta Ferreira — home" data-home-link>
        <Wordmark class="site-logo" />
      </a>
    </header>

    <slot />

    <OrbitButton
      class="get-in-touch"
      href="mailto:info@gretaferreira.com"
      label="Get in touch"
      transition:persist
    />

    <button class="theme-toggle" id="theme-toggle" type="button" transition:persist>Toggle theme</button>

    <!-- Site-wide, not page content — persists across transitions so it
         reads the same from every page instead of only existing on "/".
         Starts transparent/hidden and is animated open by script, not the
         hidden attribute (which can't be transitioned). -->
    <div id="info-panel" class="info-panel" transition:persist>
      <button class="nav-label" id="info-close" type="button">Close</button>
      <div class="info-content">
        <p data-reveal>
          With 15+ years across account and project management, strategy, and creative
          direction, I've worked with global players (Wunderman, Microsoft, Zalando,
          American Express, Guess, Nike, Adidas, Danone, and more) and been there from
          day one with startups still figuring out their name.
        </p>
        <p data-reveal>
          I'm industry-agnostic: fashion, tech, education, art. If there's a vision,
          I'll help you execute it. I care deeply about the people I work with and I'm
          committed to helping them do their best work. And at the end of the day, I
          deliver.
        </p>

        <section class="info-section">
          <h3 class="nav-label">Ventures</h3>
          <p>Co-founder <a href="https://mimosaagency.com/" target="_blank" rel="noopener noreferrer">@mimosaagency</a></p>
          <p>Co-founder <a href="https://b23.space/" target="_blank" rel="noopener noreferrer">@b23_space</a></p>
        </section>

        <section class="info-section">
          <h3 class="nav-label">Mentorship</h3>
          <p>
            Mentor at ABC Incuba, with support from the Senate Department for Culture
            and Social Cohesion in Berlin.
          </p>
        </section>

        <section class="info-section">
          <h3 class="nav-label">Connect</h3>
          <p>
            Available for networking and commissions. Connect on
            {" "}<a href="https://www.linkedin.com/in/gretaferreira/" target="_blank" rel="noopener noreferrer">LinkedIn</a>
            {" "}or via <a href="mailto:hello@gretaferreira.com">email</a>.
          </p>
        </section>
      </div>
    </div>

    <style>
      /* Hidden by default so every page that isn't a genuine first-ever
         load of "/" paints instantly, no flash — the pre-paint inline
         script in <head> is the only thing that flips data-intro="pending"
         on <html>, which is the only way this ever becomes visible. */
      .intro-overlay {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 100;
        background: var(--bg);
        align-items: center;
        justify-content: center;
        pointer-events: none;
      }
      html[data-intro="pending"] .intro-overlay {
        display: flex;
      }
      .intro-overlay__mark {
        width: min(72vw, 640px);
        opacity: 0;
        transform: scale(0.86);
        will-change: transform, opacity;
      }
      /* :global — same child-scoped-markup gotcha as .site-logo below. */
      :global(.intro-mark-svg) {
        display: block;
        width: 100%;
        height: auto;
      }
      .site-header {
        padding: var(--edge);
        display: flex;
        flex-direction: column;
      }
      .site-header__meta {
        display: flex;
        justify-content: space-between;
        /* flex-start, not center: the tagline wraps to 2 lines on a phone,
           and centering against its full height dropped "Info" down between
           the two lines instead of pinning it level with the first. */
        align-items: flex-start;
        gap: 16px;
      }
      .site-header__meta > :first-child {
        /* Same reason: give the tagline room to wrap onto its own lines
           without shoving Info around, but let it actually wrap instead of
           overflowing past Info's column. */
        flex: 1;
        min-width: 0;
      }
      /* Info and (on a project) Close live in the same row, spaced by a
         normal flex gap — they used to be able to overlap when Close was
         its own independently fixed-position element instead of sharing
         this layout with Info. */
      .header-actions {
        display: flex;
        align-items: center;
        gap: 14px;
        flex-shrink: 0;
      }
      /* Shared shape language with Close so the header's utility controls
         read as one family — Info stays text (established, clear on its
         own) but matches Close's size, border and hover colour. */
      .icon-button {
        width: 26px;
        height: 26px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        border: 1px solid var(--fg-faint);
        background: transparent;
        color: var(--fg);
        cursor: pointer;
        transition: border-color 0.2s ease, color 0.2s ease, transform 0.2s ease;
      }
      .icon-button:hover {
        color: var(--accent-hover);
        border-color: var(--accent-hover);
        transform: scale(1.08);
      }
      /* :global — the class lands on a child component's own scoped markup
         (the <svg> is rendered inside Wordmark.astro, not here), so an
         un-prefixed selector here silently never matches it. Cost real
         time twice now: this exact bug, on this exact element, is why the
         margin below kept reading as 0 no matter what number was in it. */
      :global(.site-logo) {
        display: block;
        width: 100%;
        max-width: 900px;
        height: auto;
        /* Greta: the logo reads suffocated jammed against the header row.
           Responsive — 96px is right at desktop width but is disproportionate
           on a phone, where it was also silently not applying at all. */
        margin-top: clamp(40px, 14vw, 96px);
      }
      /* :global — the class lands on a child component's own scoped markup,
         so an un-prefixed selector here would never match it. */
      :global(.get-in-touch) {
        position: fixed;
        left: 50%;
        bottom: 32px;
        transform: translateX(-50%);
        z-index: 20;
      }
      .theme-toggle {
        position: fixed;
        right: 24px;
        bottom: 32px;
        z-index: 20;
      }
      .info-panel {
        position: fixed;
        inset: 0;
        background: var(--bg);
        color: var(--fg);
        z-index: 30;
        overflow-y: auto;
        padding: var(--edge);
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
        transform: translateY(16px);
      }
      .info-content {
        max-width: 900px;
        display: flex;
        flex-direction: column;
        gap: 16px;
        font-family: var(--font-sans);
        color: var(--fg-muted);
        font-size: 1.1rem;
        line-height: 1.6;
      }
      .info-section {
        display: flex;
        flex-direction: column;
        gap: 6px;
        margin-top: 8px;
      }
      .info-section p {
        margin: 0;
      }
      .info-section a {
        text-decoration: underline;
      }
    </style>

    <script>
      import { gsap } from "gsap";
      import { revealNow, initScrollReveals } from "../scripts/reveal";
      import { initCursor } from "../scripts/cursor";
      import { initCloseLinks } from "../scripts/close-transition";
      import { shouldPlayIntro, markIntroPlayed, waitForIntro } from "../scripts/intro";

      function playIntro() {
        const overlay = document.getElementById("intro-overlay");
        const mark = overlay?.querySelector<HTMLElement>(".intro-overlay__mark");
        if (!overlay) return;

        if (!shouldPlayIntro() || !mark) {
          document.documentElement.removeAttribute("data-intro");
          document.dispatchEvent(new CustomEvent("greta:intro-done"));
          return;
        }

        const done = () => {
          document.documentElement.removeAttribute("data-intro");
          markIntroPlayed();
          document.dispatchEvent(new CustomEvent("greta:intro-done"));
        };

        gsap
          .timeline({ onComplete: done })
          .to(mark, { opacity: 1, scale: 1, duration: 0.9, ease: "power3.out" })
          .to({}, { duration: 0.45 })
          .to(mark, { scale: 1.05, duration: 0.6, ease: "power2.inOut" }, ">")
          .to(overlay, { opacity: 0, duration: 0.55, ease: "power2.inOut" }, "<");
      }

      function initThemeToggle() {
        const themeBtn = document.getElementById("theme-toggle");
        if (!themeBtn || themeBtn.dataset.bound) return;
        themeBtn.dataset.bound = "true";

        themeBtn.addEventListener("click", () => {
          const root = document.documentElement;
          const current =
            root.getAttribute("data-theme") ||
            (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
          const next = current === "dark" ? "light" : "dark";
          root.setAttribute("data-theme", next);
          localStorage.setItem("theme", next);
        });
      }

      function initInfoPanel() {
        const infoToggle = document.getElementById("info-toggle");
        const infoClose = document.getElementById("info-close");
        const infoPanel = document.getElementById("info-panel");
        if (!infoToggle || !infoPanel || infoToggle.dataset.bound) return;
        infoToggle.dataset.bound = "true";

        function open() {
          infoPanel!.style.visibility = "visible";
          infoPanel!.style.pointerEvents = "auto";
          gsap.to(infoPanel, { opacity: 1, y: 0, duration: 0.55, ease: "power3.out" });
          infoToggle!.setAttribute("aria-expanded", "true");
          // Replays every time it opens rather than just the first — the
          // panel should feel alive each visit, not just once ever.
          revealNow(infoPanel!);
        }
        function close() {
          gsap.to(infoPanel, {
            opacity: 0,
            y: 16,
            duration: 0.35,
            ease: "power2.in",
            onComplete: () => {
              infoPanel!.style.visibility = "hidden";
              infoPanel!.style.pointerEvents = "none";
            },
          });
          infoToggle!.setAttribute("aria-expanded", "false");
        }

        infoToggle.addEventListener("click", open);
        infoClose?.addEventListener("click", close);
      }

      function initPage() {
        initThemeToggle();
        initInfoPanel();
        initCursor();
        initCloseLinks();
        playIntro();

        // Nothing reveals underneath the opaque intro until it's done —
        // on every page after the first (or with the intro skipped) this
        // resolves immediately, so it's not a real delay in practice.
        waitForIntro().then(() => {
          // Only elements outside the info panel reveal on load/navigation —
          // the panel's own [data-reveal] paragraphs replay on open instead
          // (see initInfoPanel), not now, while it's still hidden.
          document.querySelectorAll<HTMLElement>("[data-reveal]").forEach((el) => {
            if (el.closest("#info-panel")) return;
            revealNow(el);
          });
          initScrollReveals(document);
        });
      }

      initPage();
      document.addEventListener("astro:page-load", initPage);
    </script>
  </body>
</html>
