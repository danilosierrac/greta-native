---
import "../styles/global.css";
import Wordmark from "../components/Wordmark.astro";
import OrbitButton from "../components/OrbitButton.astro";

interface Props {
  title: string;
}
const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <script is:inline>
      // Set theme before paint to avoid a flash of the wrong scheme.
      const stored = localStorage.getItem("theme");
      if (stored === "light" || stored === "dark") {
        document.documentElement.setAttribute("data-theme", stored);
      }
    </script>
  </head>
  <body>
    <header class="site-header">
      <div class="site-header__meta">
        <span class="nav-label">Senior Project Management &amp; Account Manager</span>
        <button class="nav-label" id="info-toggle" type="button" aria-expanded="false">Info</button>
      </div>
      <a href="/" aria-label="Greta Ferreira — home">
        <Wordmark class="site-logo" />
      </a>
    </header>

    <slot />

    <OrbitButton class="get-in-touch" href="mailto:info@gretaferreira.com" label="Get in touch" />

    <button class="theme-toggle" id="theme-toggle" type="button">Toggle theme</button>

    <div id="info-panel" class="info-panel" hidden>
      <button class="nav-label" id="info-close" type="button">Close</button>
      <slot name="info" />
    </div>

    <style>
      .site-header {
        padding: var(--edge);
        display: flex;
        flex-direction: column;
      }
      .site-header__meta {
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .site-logo {
        display: block;
        width: 100%;
        max-width: 900px;
        height: auto;
        /* Greta: the logo reads suffocated jammed against the header row —
           give it real air rather than the 8px gap the row itself uses. */
        margin-top: 48px;
      }
      /* :global — the class lands on a child component's own scoped markup,
         so an un-prefixed selector here would never match it. */
      :global(.get-in-touch) {
        position: fixed;
        left: 50%;
        bottom: 32px;
        transform: translateX(-50%);
        z-index: 20;
      }
      .theme-toggle {
        position: fixed;
        right: 24px;
        bottom: 32px;
        z-index: 20;
      }
      .info-panel {
        position: fixed;
        inset: 0;
        background: var(--bg);
        color: var(--fg);
        z-index: 30;
        overflow-y: auto;
        padding: var(--edge);
      }
    </style>

    <script is:inline>
      const root = document.documentElement;
      const themeBtn = document.getElementById("theme-toggle");
      themeBtn?.addEventListener("click", () => {
        const current =
          root.getAttribute("data-theme") ||
          (window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        const next = current === "dark" ? "light" : "dark";
        root.setAttribute("data-theme", next);
        localStorage.setItem("theme", next);
      });

      const infoToggle = document.getElementById("info-toggle");
      const infoClose = document.getElementById("info-close");
      const infoPanel = document.getElementById("info-panel");
      infoToggle?.addEventListener("click", () => {
        infoPanel?.removeAttribute("hidden");
        infoToggle.setAttribute("aria-expanded", "true");
      });
      infoClose?.addEventListener("click", () => {
        infoPanel?.setAttribute("hidden", "");
        infoToggle?.setAttribute("aria-expanded", "false");
      });
    </script>
  </body>
</html>
